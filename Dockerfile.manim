FROM python:3.11-slim

# ---- System dependencies (Manim-only: no Blender/xvfb/EGL/GL) ----
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        # TeX Live (minimal) for Manim LaTeX rendering
        texlive-latex-extra \
        texlive-fonts-recommended \
        dvisvgm \
        dvipng \
        # Cairo + Pango runtime + dev headers (pycairo/manim need headers to build)
        libcairo2 \
        libcairo2-dev \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libpango1.0-dev \
        pkg-config \
        # Native build tools (pycairo native extension compilation)
        build-essential \
        # Fonts
        fonts-dejavu \
        fonts-liberation \
        fonts-noto-core \
        # Utilities
        curl \
    && rm -rf /var/lib/apt/lists/*

# ---- Python dependencies ----
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ---- App code ----
COPY server.py .
COPY tools/ ./tools/

# SCF Web Server requirement
ENV PORT=9000

EXPOSE 9000

CMD ["python", "server.py"]
